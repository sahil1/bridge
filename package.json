{
  "name": "bridge-ai",
  "version": "3.5.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.js",
    "stop": "node scripts/stop.js",
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "demo:build": "vite build --mode demo",
    "cloud:build": "vite build --mode cloud",
    "cloud:mocks": "node scripts/cloud-mocks.js",
    "desktop": "node scripts/desktop.js start",
    "desktop:dev": "node scripts/desktop.js dev",
    "desktop:dist": "node scripts/desktop.js dist",
    "mobile:ios": "cd mobile/ios && xcodegen generate && open BridgeAI.xcodeproj",
    "mobile:android": "open -a \"Android Studio\" mobile/android",
    "mobile:android:release": "cd mobile/android && JAVA_HOME=\"${JAVA_HOME:-/Applications/Android Studio.app/Contents/jbr/Contents/Home}\" ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Library/Android/sdk}\" ./gradlew bundleRelease && echo \"Google Play bundle: mobile/android/app/build/outputs/bundle/release/app-release.aab\"",
    "icons:brands": "node scripts/brand-icons.js",
    "release": "node scripts/release.js",
    "calltap": "node scripts/calltap.js",
    "check:private": "node scripts/check-private.js",
    "test": "node test/run.mjs",
    "prepare": "node scripts/install-hooks.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "ccusage": "^20.0.41",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "quota-axi": "0.1.66",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.0",
    "playwright-core": "1.64.1",
    "simple-icons": "^16.35.0",
    "vite": "^8.3.5"
  },
  "description": "Bridge AI: one place to run, watch and talk to all your coding agents (Claude Code, Codex, Gemini, Copilot, OpenCode and more).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sahil1/bridge.git"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "bin": {
    "bridge-ai": "scripts/cli.js"
  },
  "overrides": {
    "@toon-format/toon": "2.3.1",
    "undici": "6.29.1"
  }
}
