{
  "name": "bridge-ai",
  "version": "3.13.1",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.js",
    "stop": "node scripts/stop.js",
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "demo:build": "vite build --mode demo",
    "cloud:build": "vite build --mode cloud",
    "cloud:mocks": "node scripts/cloud-mocks.js",
    "desktop": "node scripts/desktop.js start",
    "desktop:dev": "node scripts/desktop.js dev",
    "desktop:dist": "node scripts/desktop.js dist",
    "mobile:ios": "cd mobile/ios && xcodegen generate && open BridgeAI.xcodeproj",
    "mobile:ios:release": "node scripts/ios-release.js",
    "mobile:android": "open -a \"Android Studio\" mobile/android",
    "mobile:android:release": "cd mobile/android && JAVA_HOME=\"${JAVA_HOME:-/Applications/Android Studio.app/Contents/jbr/Contents/Home}\" ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Library/Android/sdk}\" ./gradlew bundleRelease && echo \"Google Play bundle: mobile/android/app/build/outputs/bundle/release/app-release.aab\"",
    "android:key": "bash scripts/android-key.sh",
    "icons:brands": "node scripts/brand-icons.js",
    "icons:boards": "node scripts/board-icons.js",
    "release": "node scripts/release.js",
    "rollout": "node scripts/rollout.js",
    "early-access": "node scripts/early-access-code.js",
    "calltap": "node scripts/calltap.js",
    "check:private": "node scripts/check-private.js",
    "test": "node test/run.mjs",
    "prepare": "node scripts/install-hooks.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@marp-team/marp-core": "^4.4.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@univerjs/preset-sheets-conditional-formatting": "1.2.0",
    "@univerjs/preset-sheets-core": "^1.2.0",
    "@univerjs/preset-sheets-data-validation": "1.2.0",
    "@univerjs/preset-sheets-filter": "1.2.0",
    "@univerjs/preset-sheets-find-replace": "1.2.0",
    "@univerjs/preset-sheets-hyper-link": "1.2.0",
    "@univerjs/preset-sheets-note": "1.2.0",
    "@univerjs/preset-sheets-sort": "1.2.0",
    "@univerjs/presets": "^1.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "ccusage": "^20.0.42",
    "docx": "^9.14.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "node-pty": "^1.1.0",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "quota-axi": "0.1.66",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "sherpa-onnx-node": "2.0.1",
    "smol-toml": "^1.9.1",
    "tiptap-markdown": "^0.9.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.3.0",
    "@tabler/icons": "3.50.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dagre-d3-es": "7.0.14",
    "exceljs": "^4.4.0",
    "jspdf": "4.2.1",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.64.1",
    "simple-icons": "^16.35.0",
    "svg2pdf.js": "2.9.0",
    "vite": "^8.3.5"
  },
  "description": "Bridge AI: one place to run, watch and talk to all your coding agents (Claude Code, Codex, Gemini, Copilot, OpenCode and more).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sahil1/bridge.git"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "bin": {
    "bridge-ai": "scripts/cli.js"
  },
  "overrides": {
    "@toon-format/toon": "2.3.1",
    "undici": "6.29.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "image-size": "2.0.4",
    "katex": "0.18.4",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
