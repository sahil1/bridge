{
  "name": "bridge-ai",
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.js",
    "stop": "node scripts/stop.js",
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "desktop": "node scripts/desktop.js start",
    "desktop:dev": "node scripts/desktop.js dev",
    "desktop:dist": "node scripts/desktop.js dist",
    "icons:brands": "node scripts/brand-icons.js",
    "release": "node scripts/release.js",
    "check:private": "node scripts/check-private.js",
    "prepare": "node scripts/install-hooks.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "ccusage": "^20.0.26",
    "dompurify": "^3.4.16",
    "express": "^5.1.0",
    "highlight.js": "^11.12.0",
    "marked": "^16.4.2",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "quota-axi": "latest",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smol-toml": "^1.9.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "simple-icons": "^16.34.0",
    "vite": "^7.0.0"
  },
  "description": "Bridge AI: one place to run, watch and talk to all your coding agents (Claude Code, Codex, Gemini, Copilot, OpenCode and more).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sahil1/bridge.git"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "bin": {
    "bridge-ai": "scripts/cli.js"
  }
}
