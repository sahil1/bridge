<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: Cloud agents, whether or not a computer is paired (MainActivity). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="cloud"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_cloud"
        android:shortcutShortLabel="@string/cloud_short"
        android:shortcutLongLabel="@string/cloud_long">
        <intent
            android:action="dev.bridgeai.phone.CLOUD"
            android:targetPackage="dev.bridgeai.phone"
            android:targetClass="dev.bridgeai.phone.MainActivity" />
    </shortcut>
</shortcuts>
