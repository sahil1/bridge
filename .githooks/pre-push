#!/bin/sh
# Refuse a push that would publish personal data (see scripts/check-private.js). Checks every
# commit being pushed, not just the last one. git passes one line per ref:
#   <local ref> <local sha> <remote ref> <remote sha>
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac # deleting a branch: nothing to check
  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;
    # A new branch: the commits the remote doesn't have yet.
    *) range="$local_sha --not --remotes" ;;
  esac
  # shellcheck disable=SC2086
  node scripts/check-private.js --commits $range || status=1
done
exit $status
